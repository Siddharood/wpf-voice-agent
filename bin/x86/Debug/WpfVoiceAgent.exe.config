<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <appSettings>
    <!-- Prefer setting this as an environment variable OPENAI_API_KEY. -->
    <add key="OpenAIApiKey" value=""/>
    <add key="OpenAIChatModel" value="gpt-4o-mini"/>
    <add key="OpenAITranscriptionModel" value="gpt-4o-mini-transcribe"/>
    <add key="OpenAITtsModel" value="gpt-4o-mini-tts"/>
    <add key="OpenAITtsVoice" value="alloy"/>
    <add key="WakePhrase" value="Computer"/>
	<add key="OpenAIRealtimeModel" value="gpt-realtime-2.1"/>
  </appSettings>
</configuration>
